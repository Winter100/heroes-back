generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  id                                Int               @id @default(autoincrement())
  name                              String            @unique
  description                       String?
  categoryId                        Int
  tierId                            Int
  image                             String?
  enchantDrop                       EnchantDrop[]
  equipmentStep                     EquipmentStep[]
  grindIngredient                   GrindIngredient[]
  itemDrop                          ItemDrop[]
  category                          Category          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tier                              ItemTier          @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slot                              Slot[]            @relation("ItemToSlot")

  @@map("items")
}

model EquipmentStep {
  id       Int    @id @default(autoincrement())
  itemId   Int
  item     Item   @relation(fields: [itemId], references: [id])

  stepName String

  stats ItemStats[]

  recipesAsResult   ItemRecipe[] @relation("ResultStep")
  recipesAsMaterial ItemRecipe[] @relation("MaterialStep")

  @@map("equipment_enhancements")
}

model ItemRecipe {
  id Int @id @default(autoincrement())

  resultId Int
  resultStep EquipmentStep @relation("ResultStep", fields: [resultId], references: [id], onDelete: Cascade)

  materialId Int
  materialStep EquipmentStep @relation("MaterialStep", fields: [materialId], references: [id], onDelete: Cascade)

  quantity Int
  description String?

  @@unique([resultId, materialId])
  @@index([resultId])
  @@index([materialId])
  @@map("items_recipes")
}

model ItemStats {
  id              Int           @id @default(autoincrement())
  statId          Int
  value           Int
  equipmentStepId Int
  equipmentStep   EquipmentStep @relation(fields: [equipmentStepId], references: [id], onDelete: Cascade)
  stat            Stat          @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@unique([equipmentStepId, statId])
  @@index([equipmentStepId])
  @@index([statId])
  @@map("items_stats")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]

  @@map("categories")
}

model ItemTier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  enchants Enchant[]
  items    Item[]

  @@map("tiers")
}

model ItemCraftTitle {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("craftTitles")
}

model Enchant {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  rankId      Int
  tierId      Int
  affixId     Int
  category    EnchantCategory @default(ENCHANT)
  effects     Effect[]
  enchantDrop EnchantDrop[]
  enchantSlot EnchantSlot[]
  affix       Affix           @relation(fields: [affixId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rank        Rank            @relation(fields: [rankId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tier        ItemTier        @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("enchants")
}

model Infusion {
  id          Int             @id @default(autoincrement())
  name        String
  rankId      Int
  affixId     Int
  category    EnchantCategory @default(INFUSION)
  effects     Effect[]
  enchantDrop EnchantDrop[]
  enchantSlot EnchantSlot[]
  affix       Affix           @relation(fields: [affixId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rank        Rank            @relation(fields: [rankId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("infusions")
}

model Partholn {
  id      Int      @id @default(autoincrement())
  name    Int
  rank    Int
  affixId Int
  effects Effect[]
  affix   Affix    @relation(fields: [affixId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("partholns")
}

model Rank {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  enchant  Enchant[]
  infusion Infusion[]

  @@map("ranks")
}

model Affix {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  value    AffixType
  enchant  Enchant[]
  infusion Infusion[]
  partholn Partholn[]

  @@map("affixs")
}

model Stat {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  image         String?
  bossStats     BossStat[]
  effects       Effect[]
  grind         Grind[]
  itemSetEffect ItemSetEffect[]
  itemStats     ItemStats[]

  @@map("stats")
}

model Effect {
  id         Int       @id @default(autoincrement())
  enchantId  Int?
  statId     Int
  value      String
  partholnId Int?
  infusionId Int?
  enchant    Enchant?  @relation(fields: [enchantId], references: [id], onDelete: Cascade)
  infusion   Infusion? @relation(fields: [infusionId], references: [id], onDelete: Cascade)
  partholn   Partholn? @relation(fields: [partholnId], references: [id], onDelete: Cascade)
  stat       Stat      @relation(fields: [statId], references: [id])

  @@map("effects")
}

model Slot {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  value           String            @unique
  enchantSlot     EnchantSlot[]
  grindSlot       GrindSlot[]
  itemSetSlotList ItemSetSlotList[]
  item            Item[]            @relation("ItemToSlot")

  @@map("slots")
}

model EnchantSlot {
  id         Int       @id @default(autoincrement())
  slotId     Int
  enchantId  Int?
  infusionId Int?
  enchant    Enchant?  @relation(fields: [enchantId], references: [id], onDelete: Cascade)
  infusion   Infusion? @relation(fields: [infusionId], references: [id], onDelete: Cascade)
  slot       Slot      @relation(fields: [slotId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("enchantSlots")
}

model Raid {
  id               Int                @id @default(autoincrement())
  raidTitleId      Int
  battle           String             @unique
  boss             String
  image            String?
  level            Int
  basicClearReward BasicClearReward[]
  bossStat         BossStat[]
  enchantDrop      EnchantDrop[]
  itemDrop         ItemDrop[]
  bonusTargets     RaidBonusTarget[]
  raidTitle        RaidTitle          @relation(fields: [raidTitleId], references: [id])

  @@map("raids")
}

model RaidTitle {
  id   Int     @id @default(autoincrement())
  name String  @unique
  grid Grind[]
  raid Raid[]

  @@map("raidTitles")
}

model BossStat {
  id     Int      @id @default(autoincrement())
  statId Int
  value  Int
  raidId Int
  type   StatType
  raid   Raid     @relation(fields: [raidId], references: [id], onDelete: Cascade)
  stat   Stat     @relation(fields: [statId], references: [id])

  @@map("bossStats")
}

model RaidBonusTarget {
  id     Int    @id @default(autoincrement())
  bonus  String
  value  String
  raidId Int
  raid   Raid   @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@map("raidBonusTargets")
}

model ItemDrop {
  id        Int     @id @default(autoincrement())
  itemId    Int
  raidId    Int
  boostUp   Boolean
  boostOnly Boolean
  item      Item    @relation(fields: [itemId], references: [id])
  raid      Raid    @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@map("itemDrops")
}

model EnchantDrop {
  id         Int       @id @default(autoincrement())
  enchantId  Int?
  raidId     Int?
  itemId     Int?
  infusionId Int?
  enchant    Enchant?  @relation(fields: [enchantId], references: [id], onDelete: Cascade)
  infusion   Infusion? @relation(fields: [infusionId], references: [id], onDelete: Cascade)
  item       Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  raid       Raid?     @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@map("enchantDrops")
}

model BasicClearRewardName {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  basicClearReward BasicClearReward[]

  @@map("basicClearRewardNames")
}

model BasicClearReward {
  id                     Int                  @id @default(autoincrement())
  basicClearRewardNameId Int
  value                  Int
  raidId                 Int
  basicClearRewardName   BasicClearRewardName @relation(fields: [basicClearRewardNameId], references: [id])
  raid                   Raid                 @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@map("basicClearRewards")
}

model Character {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  image          String
  characterSkill CharacterSkill[]

  @@map("characters")
}

model Skill {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String
  image          String
  characterSkill CharacterSkill[]

  @@map("skills")
}

model CharacterSkill {
  id          Int       @id @default(autoincrement())
  characterId Int
  skillId     Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("characters_skills")
}

model User {
  id            String        @id @default(uuid())
  name          String        @unique
  email         String        @unique
  password      String
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  refreshTokens RefreshToken?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refreshToken")
}

model Grind {
  id              Int               @id @default(autoincrement())
  titleId         Int
  statId          Int
  statOneValue    Int               @map("stat_one_value")
  statMaxValue    Int               @map("stat_max_value")
  stat            Stat              @relation(fields: [statId], references: [id], onDelete: Cascade)
  title           RaidTitle         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  grindIngredient GrindIngredient[]
  grindSlot       GrindSlot[]

  @@map("grinds")
}

model GrindSlot {
  id      Int   @id @default(autoincrement())
  grindId Int
  slotId  Int
  grind   Grind @relation(fields: [grindId], references: [id], onDelete: Cascade)
  slot    Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("grinds_slots")
}

model GrindIngredient {
  id       Int   @id @default(autoincrement())
  grindId  Int
  itemId   Int
  quantity Int
  grind    Grind @relation(fields: [grindId], references: [id], onDelete: Cascade)
  item     Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([grindId, itemId])
  @@index([itemId])
  @@map("grinds_ingredients")
}

model ItemSet {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  itemSetBonus    ItemSetEffect[]
  itemSetList     ItemSetList[]
  itemSetSlotList ItemSetSlotList[]

  @@map("item_sets")
}

model ItemSetEffect {
  id        Int          @id @default(autoincrement())
  levelId   Int
  setId     Int
  statId    Int
  statValue Int
  level     ItemSetLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  set       ItemSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  stat      Stat         @relation(fields: [statId], references: [id], onDelete: Cascade)

  @@map("items_sets_effects")
}

model ItemSetLevel {
  id            Int             @id @default(autoincrement())
  level         Int
  itemSetEffect ItemSetEffect[]

  @@map("items_sets_level")
}

model ItemSetNameList {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  itemSetList ItemSetList[]

  @@map("items_sets_name_list")
}

model ItemSetSlotList {
  id     Int     @id @default(autoincrement())
  setId  Int
  slotId Int
  set    ItemSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  slot   Slot    @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("items_sets_slots_list")
}

model ItemSetList {
  id            Int             @id @default(autoincrement())
  setId         Int
  itemSetListId Int
  item          ItemSetNameList @relation(fields: [itemSetListId], references: [id], onDelete: Cascade)
  set           ItemSet         @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("items_sets_list")
}

// 레시피는 삭제 예정
model recipes {
  id                              Int     @id @default(autoincrement())
  resultId                        Int
  materialId                      Int
  quantity                        Int
  description                     String?
  @@unique([resultId, materialId])
  @@index([materialId])
  @@index([resultId])
}

enum EnchantCategory {
  ENCHANT
  INFUSION
}

enum StatType {
  ENTRY
  LIMIT
}

enum UserRole {
  USER
  ADMIN
}

enum AffixType {
  PREFIX
  SUFFIX
  INFUSION
  PARTHOLN
}
